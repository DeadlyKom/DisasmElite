  12++0000 ~            ; -----------------------------------------
  13++0000 ~            ; битовые поля расширенной записи, обычный формат TypeFlags
  14++0000 ~            ;       7    6    5    4    3    2    1    0
  15++0000 ~            ;     +----+----+----+----+----+----+----+----+
  16++0000 ~            ;     | AC | GM | TM | SR | EN | IT | GP | GP |
  17++0000 ~            ;     +----+----+----+----+----+----+----+----+
  18++0000 ~            ; AC [7] - флаг, запись допускается как цель расширенного взаимодействия
  19++0000 ~            ;   Game.Universe.TryObjectInteraction.Entry отклоняет цель при AC=0
  20++0000 ~            ;   Game.Universe.UpdateExtendedObjectEffects.FindPartner временно снимает AC у источника на время поиска, затем
  21++0000 ~            ;   устанавливает
  22++0000 ~            ; GM [6] - флаг, взаимодействие цели проверяется по двухбитным группам
  23++0000 ~            ;   Game.Universe.TryObjectInteraction.Entry при GM=1 требует различные GP и дополнительный допуск IT
  24++0000 ~            ;   при GM=0 проверяет IT, совпадение собственного номера цели и случайный допуск
  25++0000 ~            ;   Game.Extensions.ChooseLinkedObjectTarget.CheckSearch требует GM вместе с SR для поиска новой резервной цели
  26++0000 ~            ; TM [5] - флаг, запись участвует в ветви обновления таймера и особого эффекта
  27++0000 ~            ;   Game.Universe.UpdateExtendedObjectEffects.ProcessSlot обновляет Timer при AC=GM=1 либо при TM=1
  28++0000 ~            ;   после истечения таймера GM=0 направляет запись к круговому эффекту
  29++0000 ~            ;   при GM=1 и TM=1 применяются дополнительные условия энергии, группы и случайности
  30++0000 ~            ; SR [4] - флаг, разрешён поиск новой резервной цели
  31++0000 ~            ;   Game.Extensions.ChooseLinkedObjectTarget.CheckSearch требует SR=1 и GM=1 после отказа всех сохранённых ссылок
  32++0000 ~            ;   поиск проверяет семь записей с верхней тетрадой #9, затем возможность станции
  33++0000 ~            ; EN [3] - флаг, используется энергетический эффект вместо обычного каркаса
  34++0000 ~            ;   Game.Universe.SpawnDestructionContentsAndEffects.CheckEffects после исключения кругового типа проверяет EN и
  35++0000 ~            ; выбирает энергетическую ветвь
  36++0000 ~            ;   Game.Universe.InitializeExtendedObjectMetadata.StoreFlags разрешает случайную установку EN только при
  37++0000 ~            ; установленном бите MS_CLOAK_BIT поля State.MissionFlags
  38++0000 ~            ; IT [2] - флаг, разрешающий признак взаимодействия с отдельными целями
  39++0000 ~            ;   Game.Universe.TryObjectInteraction.Entry проверяет его у цели либо источника в зависимости от GM и типа источника
  40++0000 ~            ;   Game.Wireframe.MergeInverseHostilityFlag.Entry добавляет IT результату, если у другого участника IT сброшен
  41++0000 ~            ;   Game.Extensions.ChooseLinkedObjectTarget.CheckSearch запрещает выбирать станцию резервной целью при IT=1
  42++0000 ~            ; GP [1..0] - числовое поле, группа 0..3, не два независимых флага
  43++0000 ~            ;   Game.Universe.InitializeExtendedObjectMetadata.CompareModel объединяет исходный тип каталога с фазой

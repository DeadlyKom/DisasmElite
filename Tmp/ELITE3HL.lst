  42++0000 ~            ;
  43++0000 ~            ;   CY      [7..1]  - числовой номер физического цилиндра
  44++0000 ~            ;   SD      [0]     - выбор стороны, SetTrackSide переносит его в Carry через RRA
  45++0000 ~            ;   значение 0 выбирает запись #3C в порт #FF, значение 1 выбирает #2C
  46++0000 ~            ; -----------------------------------------
  47++0000 ~            FreeTrack       DB #00                                                          ; +E2, следующая свободная логическая дорожка
  48++0000 ~            DiskType        DB #00                                                          ; +E3, байт типа диска, здесь не изменяется
  49++0000 ~            FileCount       DB #00                                                          ; +E4, число занятых записей каталога

   1++0005              ; -----------------------------------------------------------------------------
   2++0005              ; перенос просмотрщика и упакованного текста из строки REM в исходные адреса
   3++0005              ; In:
   4++0005              ;   BC - PROG + 5, адрес первой инструкции после токена REM
   5++0005              ; Out:
   6++0005              ;   HL - адрес шрифта минус 256, значение системной переменной CHARS
   7++0005              ;   стек - адрес начала упакованного текста Manual.PACK_BASE
   8++0005              ;   переход в Initialize
   9++0005              ; Corrupt:

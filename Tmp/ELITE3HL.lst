  25++C863                              ; сохранённый машинный фрагмент после перекрывающейся строки, вход не установлен
  26++C863 CD 75 D9     LegacyRead:     CALL @Game.Disk.BlackAttributesAndOverlayState.Entry            ; очистка 768 атрибутных байтов, на выходе HL=(Memory.Attributes + #0300) и BC=0
  27++C866 3E 0E                        LD A, #0E
  28++C868 CD 7D C8                     CALL SetTrackSide

  26++8F10 A7                           AND A
  27++8F11 C8                           RET Z                                                           ; выход, если в объектном кадре не было ни одного непустого слота
  28++8F12
  29++8F12                              ; перенаправление рисования с буфера на реальный экран
  30++8F12 3E 40                        LD A, #40
  31++8F14 32 4A 8A                     LD (CircleRaster.FillTop), A

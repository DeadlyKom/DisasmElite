   1++F8D7                              module Extensions
   2++F8D7                              module DrawCircleAndProtectScratchStack
   3++F8D7              ; -----------------------------------------
   4++F8D7              ; вывод кругового объекта и защищённый вызов боевого обработчика
   5++F8D7              ; исходный диапазон #F8D7..#F90D
   6++F8D7              ; смысловое имя DrawCircleAndProtectScratchStack
   7++F8D7              ; In: CircleState.OffsetY, OffsetX, Flags и Radius, для NextOrFinish Z является результатом внешней проверки
   8++F8D7              ; Out: первый вход возвращает A=(CircleState.Radius), второй продолжает бой либо вызывает Game.Combat.FinishObjectFrame.Entry
   9++F8D7              ; Corrupt: HL, DE, BC, AF и буфер экрана по контрактам вызываемых процедур
  10++F8D7              ; Game.Extensions.DrawCircleAndProtectScratchStack.NextOrFinish при Z=0 сразу переходит к Game.Combat.UpdateAllSpaceObjects.ProcessSlot
  11++F8D7              ; при Z=1 копирует 48 байтов ScratchStack в ScratchBackup и устанавливает SP сразу за ScratchStack
  12++F8D7              ; После Game.Combat.FinishObjectFrame.Entry байты и исходный SP восстанавливаются, выполняется EI
  13++F8D7              ; Game.Extensions.DrawCircleAndProtectScratchStack.SavedSP — самомодифицируемый операнд LD SP,nn
  14++F8D7              ; -----------------------------------------
  15++F8D7                              ; проверка исходного начала фрагмента
  16++F8D7                              ASSERT $ == #F8D7
  17++F8D7                              ; рисование круга, завершение экранного буфера и копирование на экран
  18++F8D7 CD 74 8F     Entry:          CALL Game.Circles.SelectCircleBackBuffer.Entry
  19++F8DA CD D0 86                     CALL Game.Screen.DrawFilledCircle.Entry
  20++F8DD CD BE 7F                     CALL Game.Screen.CopyFlightView.Entry
  21++F8E0 3A 1D 86                     LD A, (CircleState.Radius)
  22++F8E3 C9                           RET
  23++F8E4
  24++F8E4                              ; дополнительный вход с проверкой внешнего результата
  25++F8E4 C2 38 9D     NextOrFinish:   JP NZ, Game.Combat.UpdateAllSpaceObjects.ProcessSlot            ; переход, если внешняя проверка дала ненулевой результат, продолжить по Game.Combat.UpdateAllSpaceObjects.ProcessSlot
  26++F8E7
  27++F8E7                              ; сохранение SP и 48 байтов области временного стека
  28++F8E7 ED 73 0A F9                  LD (SavedSP), SP
  29++F8EB F3                           DI
  30++F8EC 21 F0 40                     LD HL, ScratchStack
  31++F8EF 11 D0 FF                     LD DE, ScratchBackup
  32++F8F2 01 30 00                     LD BC, #0030
  33++F8F5 ED B0                        LDIR
  34++F8F7                              ; вызов боевого обработчика со стеком ScratchStack + 48
  35++F8F7 31 20 41                     LD SP, ScratchStack + #0030
  36++F8FA CD 66 9E                     CALL Game.Combat.FinishObjectFrame.Entry
  37++F8FD F3                           DI

  25++E778 FD 46 05                     LD B, (IY + FSpaceObject.Y.SignHigh)
  26++E77B CB B8                        RES 7, B
  27++E77D 09                           ADD HL, BC
  28++E77E CD 8F E7                     CALL CompareWords
  29++E781 D0                           RET NC                                                          ; выход, если сумма модулей X и Y не меньше порога, не читать Z
  30++E782
  31++E782                              ; прибавление модуля Z и окончательное сравнение
  32++E782 FD 4E 07                     LD C, (IY + FSpaceObject.Z.Low)
  33++E785 FD 46 08                     LD B, (IY + FSpaceObject.Z.SignHigh)
  34++E788 CB B8                        RES 7, B
  35++E78A 09                           ADD HL, BC
  36++E78B CD 8F E7                     CALL CompareWords
  37++E78E C9                           RET

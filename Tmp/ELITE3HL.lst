  11++0000              CIRC_YRANGE_BIT EQU 3                                                           ; флаг, обычная ветвь проверки вертикального диапазона
  12++0000              CIRC_RIGHT_MASK EQU 1 << CIRC_RIGHT_BIT                                         ; маска горизонтального направления центра

  32++0000              ; -----------------------------------------
  33++0000                              struct FTrDosService
  34++0000 ~            Reserved        DS #E1, #00                                                     ; +00..E0, сохранённая часть сектора
  35++0000 ~            FreeSector      DB #00                                                          ; +E1, следующий свободный сектор, 0..15
  36++0000 ~            ; -----------------------------------------
  37++0000 ~            ; логическая дорожка TR-DOS
  38++0000 ~            ;      7    6    5    4    3    2    1    0

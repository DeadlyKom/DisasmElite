  21++FF2D                              ; сохранение всех основных регистров обработчика
  22++FF2D E5                           PUSH HL
  23++FF2E D5                           PUSH DE
  24++FF2F C5                           PUSH BC
  25++FF30 F5                           PUSH AF
  26++FF31 DD E5                        PUSH IX
  27++FF33 FD E5                        PUSH IY
  28++FF35                              ; опрос клавиатуры, интегрирование управления и обновление такта игры
  29++FF35              KeyboardCall    EQU $ + 1                                                       ; операнд CALL опроса клавиатуры, демо подставляет обработчик кадра
  30++FF35 CD 69 FD                     CALL Game.Input.ScanKeyboardMatrix.Entry
  31++FF38 CD 01 FE                     CALL Game.Input.IntegrateFlightControls.Entry
  32++FF3B CD 25 71                     CALL Game.Flight.DispatchSoundEffect.Entry

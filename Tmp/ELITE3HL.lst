  33++BD79 FD 5E 05                     LD E, (IY+FAxis.Z+FSignWord.SignHigh)
  34++BD7C FD 4E 04                     LD C, (IY+FAxis.Z+FSignWord.Low)
  35++BD7F DD 7E 02                     LD A, (IX+FVector3.Z)
  36++BD82 CD 95 BD                     CALL Game.Motion.MultiplySignedWordByByte.Entry

   6++8F0D              ; смысловое имя DrawPendingObjectExplosions
   7++8F0D              ; In: CombatState.ObjectsPresent — наличие объектов, массив от Memory.Station с шагом 39
   8++8F0D              ; Out: для отмеченных объектов выведены расширяющиеся круги и снят флаг запроса уничтожения
   9++8F0D              ; Corrupt: HL, DE, BC, AF, HL', DE', BC', AF', IX
  10++8F0D              ; Общий признак наличия объектов допускает обход, затем проверяются флаги каждого слота
  11++8F0D              ; Обрабатываются объекты со всеми битами OBJ_DEATH_MASK в FSpaceObject.Flags, центр, знаки и радиус берутся из ExplodeX, ExplodeY, SignPhase и Radius
  12++8F0D              ; Перед циклом рендер перенаправляется на экран с пределами #40..#4F
  13++8F0D              ; Один взрыв рисуется четырьмя кругами, радиус увеличивается на 3, счётчик цвета уменьшается на 4
  14++8F0D              ; После всех восьми слотов выполнение проваливается в Game.Circles.SelectCircleBackBuffer.Entry и восстанавливает буферный режим
  15++8F0D              ; -----------------------------------------
  16++8F0D                              ; смещения описывают исходные данные, память не выделяется
  17++8F0D              ExplodeX:       EQU FSpaceObject.Acceleration                                   ; экранный X взрыва вместо ускорения, записывает StartObjectExplosion
  18++8F0D              ExplodeY:       EQU FSpaceObject.Roll                                           ; экранный Y взрыва вместо крена
  19++8F0D              SignPhase:      EQU FSpaceObject.Pitch                                          ; знаки центра и фаза вместо команды тангажа
  20++8F0D              Radius:         EQU FSpaceObject.Payload                                        ; радиус взрыва вместо обычной нагрузки объекта
  21++8F0D
  22++8F0D                              ; проверка исходного начала фрагмента
  23++8F0D                              ASSERT $ == #8F0D
  24++8F0D                              ; проверка наличия объектов перед обходом их запросов взрыва

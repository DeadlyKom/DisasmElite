  11++0000 ~            LengthHigh      DB #00                                                          ; +0C, старший байт логической длины
  12++0000 ~            SectorCount     DB #00                                                          ; +0D, выделенное число секторов
  13++0000 ~            FirstSector     DB #00                                                          ; +0E, первый сектор, нумерация 0..15
  14++0000 ~            ; -----------------------------------------
  15++0000 ~            ; логическая дорожка TR-DOS
  16++0000 ~            ;      7    6    5    4    3    2    1    0
  17++0000 ~            ;   +----+----+----+----+----+----+----+----+
  18++0000 ~            ;   | CY | CY | CY | CY | CY | CY | CY | SD |
  19++0000 ~            ;   +----+----+----+----+----+----+----+----+
  20++0000 ~            ;
  21++0000 ~            ;   CY      [7..1]  - числовой номер физического цилиндра
  22++0000 ~            ;   SD      [0]     - выбор стороны, SetTrackSide переносит его в Carry через RRA
  23++0000 ~            ;   значение 0 выбирает запись #3C в порт #FF, значение 1 выбирает #2C
  24++0000 ~            ; -----------------------------------------
  25++0000 ~            FirstTrack      DB #00                                                          ; +0F, логическая дорожка, младший бит выбирает сторону

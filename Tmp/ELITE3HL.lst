   4++011E              ; исходная токенизированная строка BASIC 10, запускающая машинный загрузчик
   5++011E              ; PAPER NOT PI, INK VAL "7", BORDER NOT PI, CLS
   6++011E              ; RANDOMIZE USR (PEEK VAL "23635" + VAL "256" * PEEK VAL "23636" + VAL "5")
   7++011E              ; после возврата выводится сообщение об отсутствии ELITE3.C
   8++011E              ; Note:
   9++011E              ;   строка REM 0 намеренно не завершается байтом #0D
  10++011E              ;   её граница задаётся длиной #011A в заголовке, байты оригинала сохранены
  11++011E              ;   #AF внутри сообщения также сохранён как исходный байт
  12++011E              ; -----------------------------------------
  13++011E 00 0A        BasicLine:      DB #00, #0A                                                     ; номер строки BASIC 10
  14++0120 5F 00                        DW #005F                                                        ; длина тела строки вместе с #0D
  15++0122 DA C3 A7 3A                  DB #DA, #C3, #A7, #3A                                           ; PAPER NOT PI
  16++0126 D9 B0 22 37                  DB #D9, #B0, #22, "7", #22, #3A                                 ; INK VAL "7"
  16++012A 22 3A
  17++012C E7 C3 A7 3A                  DB #E7, #C3, #A7, #3A                                           ; BORDER NOT PI
  18++0130 FB 3A                        DB #FB, #3A                                                     ; CLS
  19++0132 F9 C0 28 BE                  DB #F9, #C0, #28, #BE, #B0, #22, "23635", #22, #2B              ; RANDOMIZE USR (PEEK VAL "23635" +
  19++0136 B0 22 32 33
  19++013A 36 33 35 22
  19++013E 2B
  20++013F B0 22 32 35                  DB #B0, #22, "256", #22, #2A, #BE, #B0, #22, "23636", #22, #2B  ; VAL "256" * PEEK VAL "23636" +
  20++0143 36 22 2A BE
  20++0147 B0 22 32 33
  20++014B 36 33 36 22
  20++014F 2B
  21++0150 B0 22 35 22                  DB #B0, #22, "5", #22, #29, #3A                                 ; VAL "5")
  21++0154 29 3A
  22++0156 FB 3A                        DB #FB, #3A                                                     ; CLS
  23++0158 F5 AC B0 22                  DB #F5, #AC, #B0, #22, "11", #22, #2C                           ; PRINT AT VAL "11",
  23++015C 31 31 22 2C
  24++0160 B0 22 31 22                  DB #B0, #22, "1", #22, #3B                                      ; VAL "1" и разделитель вывода

   3++0000
   4++0000              ; -----------------------------------------
   5++0000              ; поля FCommander, расположение битов описано непосредственно перед полями
   6++0000              ; *_BIT используются в BIT/SET/RES, *_MASK в логических операциях
   7++0000              ; -----------------------------------------
   8++0000              RANK_WAR_BIT    EQU 7                                                           ; флаг, вывод воинского звания в RankState
   9++0000              RANK_RSV_BIT    EQU 6                                                           ; флаг, отставка и запрет поиска секретной базы
  10++0000              RANK_NEXT_BIT   EQU 0                                                           ; флаг, разрешена проверка очередного задания
  11++0000              RANK_WAR_MASK   EQU 1 << RANK_WAR_BIT                                           ; маска признака воинского звания
  12++0000              RANK_RSV_MASK   EQU 1 << RANK_RSV_BIT                                           ; маска отставки IN RESERVE
  13++0000              RANK_NEXT_MASK  EQU 1 << RANK_NEXT_BIT                                          ; маска разрешения очередного задания
  14++0000              RANK_NUM_MASK   EQU #0E                                                         ; биты 3..1, числовой номер воинского звания
  15++0000              RANK_CODE_MASK  EQU #FF ^ RANK_NEXT_MASK                                        ; код состояния без признака очередного задания
  16++0000              RANK_TYPE_MASK  EQU RANK_WAR_MASK | RANK_NUM_MASK                               ; военный признак и номер звания без отставки и NX
  17++0000              RANK_ELITE_MIN  EQU #20                                                         ; минимальный старший рейтинг для попытки запуска вторжения
  18++0000              RANK_START_CODE EQU RANK_WAR_MASK | RANK_NEXT_MASK                              ; начальное военное состояние #81 до ответа добровольца
  19++0000              RANK_LT_CODE    EQU RANK_WAR_MASK | (1 << 1)                                    ; военный код #82, первый полученный чин
  20++0000              RANK_CAPT_CODE  EQU RANK_WAR_MASK | (2 << 1)                                    ; военный код #84, порог перевозки десанта
  21++0000              RANK_MAJ_CODE   EQU RANK_WAR_MASK | (3 << 1)                                    ; военный код #86, допуск предложения десанта
  22++0000              RANK_COL_RSV    EQU RANK_WAR_MASK | RANK_RSV_MASK | (4 << 1)                    ; код #C8, особое окончание печати воинского звания
  23++0000              JUMP_MSN_BIT    EQU 7                                                           ; флаг, проверка выдачи старых миссий при прибытии
  24++0000              JUMP_COUNT_MASK EQU #7F                                                         ; старшие числовые разряды счётчика без разрешения миссии
  25++0000              MS_ACCEPT_BIT   EQU 7                                                           ; флаг, принято предложение третьей миссии
  26++0000              MS_CLOAK_BIT    EQU 6                                                           ; флаг, получено устройство маскировки
  27++0000              MS_CARGO_BIT    EQU 5                                                           ; флаг, трюм занят беженцами либо десантом
  28++0000              MS_MARK5_BIT    EQU 4                                                           ; флаг, пятая отметка общей последовательности заданий
  29++0000              MS_MARK4_BIT    EQU 3                                                           ; флаг, выдана награда третьей миссии, четвёртая отметка войны
  30++0000              MS_MARK3_BIT    EQU 2                                                           ; флаг, третья миссия выдана либо система освобождена десантом
  31++0000              MS_MARK2_BIT    EQU 1                                                           ; флаг, вторая миссия выдана либо выполнена военная поставка
  32++0000              MS_MARK1_BIT    EQU 0                                                           ; флаг, первая миссия выдана либо выполнена эвакуация
  33++0000              MS_ACCEPT_MASK  EQU 1 << MS_ACCEPT_BIT                                          ; маска признака MS_ACCEPT_BIT
  34++0000              MS_CLOAK_MASK   EQU 1 << MS_CLOAK_BIT                                           ; маска признака MS_CLOAK_BIT
  35++0000              MS_CARGO_MASK   EQU 1 << MS_CARGO_BIT                                           ; маска признака MS_CARGO_BIT
  36++0000              MS_MARK5_MASK   EQU 1 << MS_MARK5_BIT                                           ; маска признака MS_MARK5_BIT
  37++0000              MS_MARK4_MASK   EQU 1 << MS_MARK4_BIT                                           ; маска признака MS_MARK4_BIT
  38++0000              MS_MARK3_MASK   EQU 1 << MS_MARK3_BIT                                           ; маска признака MS_MARK3_BIT
  39++0000              MS_MARK2_MASK   EQU 1 << MS_MARK2_BIT                                           ; маска признака MS_MARK2_BIT

  10++0000              .SavedSP        EQU #FFFE                                                       ; сохранённый SP на время форматирования
  11++0000              .ScreenBackup   EQU DiskBuffer.SavedSP - #20                                    ; 32 сохранённых байта экрана перед DiskBuffer.SavedSP
  12++0000              .TimingTrack    EQU DiskBuffer + #91                                            ; выбранная дорожка проверки
  13++0000              DiskService     EQU DiskBuffer.Work                                             ; представление служебного сектора 9
  14++0000              .FreeSector     EQU DiskService + FTrDosService.FreeSector                      ; сектор и следующая за ним дорожка свободного места
  15++0000              .FreeTrack      EQU DiskService + FTrDosService.FreeTrack                       ; дорожка следующего свободного сектора
  16++0000              .FileCount      EQU DiskService + FTrDosService.FileCount                       ; число каталожных записей
  17++0000              .FreeCount      EQU DiskService + FTrDosService.FreeCount                       ; число свободных секторов
  18++0000              DiskMark        EQU DiskBuffer.Work                                             ; представление защитного сектора
  19++0000              .Value          EQU DiskMark + FDiskMark.Value                                  ; подтверждаемый счётчик
  20++0000              .NextValue      EQU DiskMark + FDiskMark.NextValue                              ; контрольное следующее слово
  21++0000              .TimingKey      EQU DiskMark + FDiskMark.TimingKey                              ; измерение и ключ XOR
  22++0000              .Counters       EQU DiskMark + FDiskMark.Counters                               ; три слова для вывода
  23++0000              .Suffix         EQU DiskMark + FDiskMark.Suffix                                 ; дополнительное слово вывода

  92  0066                              ; восстановление дискового кодирования и побочных байт образа
  93  0066                              ; финализатор выполняется встроенным Lua в конце третьего прохода
  94  0066                              IF 0 = 0
  95  0066                              LUA PASS3
  96  0066 ~                                local ok, reason = pcall(dofile, "Tools/pack.lua")
  97  0066 ~                                if not ok then

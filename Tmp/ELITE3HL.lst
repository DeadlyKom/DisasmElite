   1++EBE1              ; -----------------------------------------
   2++EBE1              ; Кеш восьми флагов объектных метаданных
   3++EBE1              ; исходный диапазон #EBE1..#EBE8
   4++EBE1              ; In:
   5++EBE1              ;   ReadSlotFlags обновляет из ObjectEffects.Records + FEffectRecord10 * n
   6++EBE1              ; Out:
   7++EBE1              ;   по одному байту на слот Memory.Station + FSpaceObject * n
   8++EBE1              ; Corrupt:
   9++EBE1              ;   нет, восемь байтов данных
  10++EBE1              ; Note:
  11++EBE1              ;   Кеш изначально нулевой, обновляется только если прерывание застало HALT
  12++EBE1              ;   Скопировано поле FEffectRecord10.TypeFlags, полный формат описан в Includes/Structs/EffectRecord.inc
  13++EBE1              ;   Ниже отмечены только биты, которые проверяет демонстрационный алгоритм
  14++EBE1              ; -----------------------------------------
  15++EBE1              ;      7    6    5    4    3    2    1    0
  16++EBE1              ;   +----+----+----+----+----+----+----+----+
  17++EBE1              ;   | AC | GM | .. | SR | .. | .. | GP | .. |
  18++EBE1              ;   +----+----+----+----+----+----+----+----+
  19++EBE1              ;
  20++EBE1              ;   метаданные, используемые демонстрацией:
  21++EBE1              ;   AC      [7]     - флаг, запись допускается к расширенному взаимодействию
  22++EBE1              ;   GM      [6]     - флаг, взаимодействие проверяется по группам
  23++EBE1              ;   SR      [4]     - флаг, разрешён поиск резервной цели
  24++EBE1              ;   GP      [1]     - старший бит двухбитной группы взаимодействий
  25++EBE1              ;   ..      [5, 3, 2, 0] - демонстрационные проверки эти биты не читают
  26++EBE1              ;
  27++EBE1              ;   AllowAttack требует AC, при GM достаточно группы 2/3 либо враждебности объекта
  28++EBE1              ;   при GM=0 AllowAttack требует SR=0, а RejectCargo требует SR=1
  29++EBE1              ;   это критерии выбора демо, исходное назначение SR в игре не меняется
  30++EBE1              ; -----------------------------------------

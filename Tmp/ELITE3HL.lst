  14++0000              CIRC_XRANGE_MSK EQU 1 << CIRC_XRANGE_BIT                                        ; маска обычного горизонтального диапазона
  15++0000              CIRC_YRANGE_MSK EQU 1 << CIRC_YRANGE_BIT                                        ; маска обычного вертикального диапазона
  16++0000              CIRC_SIGN_MASK  EQU CIRC_RIGHT_MASK | CIRC_UP_MASK                              ; два направления центра окружности
  17++0000              CIRC_RANGE_MASK EQU CIRC_XRANGE_MSK | CIRC_YRANGE_MSK                           ; обычный диапазон обеих осей, маска #0C

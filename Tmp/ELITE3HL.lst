  13++0000              DOS_TRACK_SIZE  EQU #10                                                         ; число секторов логической дорожки
  14++0000              DOS_CAT_MASK    EQU #07                                                         ; номер сектора каталога до прибавления единицы, 0..7
  15++0000              DOS_SLOT_MASK   EQU #F0                                                         ; смещение шестнадцатибайтовой записи внутри сектора
  16++0000              MARK_TOP_BIT    EQU 7                                                           ; разряд H, сбрасываемый при ограничении отметки пятнадцатью битами

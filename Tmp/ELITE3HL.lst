 199++0000 ~            ;   Game.Missions.SpecialMessageAndScoopReward.ScoopItem ставит его при коде предмета #FF
 200++0000 ~            ;   Game.Flight.ToggleCloakingDevice.Entry проверяет разрешение клавиши Y
 201++0000 ~            ;   Game.Menus.PrintCombatRankAndEquipment.Entry выводит устройство после перебора лазеров
 202++0000 ~            ;   Game.Universe.InitializeExtendedObjectMetadata.StoreFlags учитывает CL при выборе FX_ENERGY_BIT
 203++0000 ~            ;   Game.Objects.GenerateSpaceTraffic.Entry требует CL=0 вместе с R2=1 для особой встречи
 204++0000 ~            ;   CG      [5]     - флаг, трюм занят беженцами либо десантом, MS_CARGO_BIT
 205++0000 ~            ;   Game.Trade.MissionRegionMetric.BoardRefugees ставит его после Y и очищает трюм с State.FreeCargo
 206++0000 ~            ;   Game.Charts.NextScreenCharacterRowAndRefugees.OfferRefugees запрещает повторное предложение
 207++0000 ~            ;   Game.Text.OfferRegionDependentMission.OfferVolunteer также проверяет занятость трюма
 208++0000 ~            ;   Game.Extensions.PrintCargoAndMessageBanks.Entry выводит особый груз
 209++0000 ~            ;   Game.Universe.SelectSpecialCargoText.Entry выбирает подпись беженцев либо десанта
 210++0000 ~            ;   Game.Trade.PromptCargoQuantityAndRefugees.UnloadRefugees снимает CG при высадке
 211++0000 ~            ;   Game.Combat.HandleEscapeCapsule.ClearCargo снимает CG при запуске спасательной капсулы
 212++0000 ~            ;   Game.Extensions.CreateMissileOrMissionCraft.Entry снимает CG при выпуске десанта
 213++0000 ~            ;   R5      [4]     - флаг, пятая отметка общей последовательности заданий, MS_MARK5_BIT
 214++0000 ~            ;   отдельной команды установки этого бита в разобранном игровом коде не найдено
 215++0000 ~            ;   смысл конкретного выполненного задания по одному чтению не определяется
 216++0000 ~            ;   R4      [3]     - флаг, награда за третью миссию выдана, MS_MARK4_BIT
 217++0000 ~            ;   Game.Missions.CompleteThirdMission.Entry устанавливает эту отметку
 218++0000 ~            ;   R3      [2]     - флаг, третья миссия выдана либо система освобождена десантом, MS_MARK3_BIT
 219++0000 ~            ;   Game.Travel.GetSalePriceAndMissionFlags.ThirdMission ставит R3 вместе с State.Mission3 = 1
 220++0000 ~            ;   Game.Text.HandleSpecialObjectMission.DestroyStation ставит R3 при освобождении занятой системы
 221++0000 ~            ;   R2      [1]     - флаг, вторая отметка общей последовательности заданий, MS_MARK2_BIT
 222++0000 ~            ;   Game.Travel.GetSalePriceAndMissionFlags.SecondMission устанавливает её при выдаче события
 223++0000 ~            ;   Game.Text.NextDescriptionRandom.CheckWarSupply ставит R2 после военной поставки еды либо оружия
 224++0000 ~            ;   Game.Objects.GenerateSpaceTraffic.Entry читает комбинацию R2=1 и CL=0
 225++0000 ~            ;   R1      [0]     - флаг, первая отметка общей последовательности заданий, MS_MARK1_BIT
 226++0000 ~            ;   Game.Travel.GetSalePriceAndMissionFlags.GrantMission ставит её вместе с State.Mission1 = 1
 227++0000 ~            ;   Game.Universe.ApplyEnhancedFlightControl.CheckRefugees проверяет допуск высадки беженцев
 228++0000 ~            ;   при активном вторжении допустимая высадка доходит до Game.Universe.ApplyEnhancedFlightControl.MarkResult
 229++0000 ~            ;   этот вход устанавливает R1, при State.Invasion < 2 отметка не меняется
 230++0000 ~            ;   Game.Text.OfferRegionDependentMission.FindRewardBit проверяет отметку по номеру военного этапа
 231++0000 ~            ;   число вращений допускает чтение битов 0..6, включая общие отметки и флаги CG/CL
 232++0000 ~            ;   Game.Travel.GetSalePriceAndMissionFlags.GrantMission проверяет входное A AND State.MissionFlags
 233++0000 ~            ;   Game.Extensions.UpdateInvasionOnRatingOverflow.Entry применяет MS_START_MASK при начале войны
 234++0000 ~            ;   маска сохраняет M3, CL и R5, очищает CG и R1..R4
 235++0000 ~            ;   R1..R3 имеют общие применения в обычных миссиях и военных заданиях
 236++0000 ~            ; -----------------------------------------
 237++0000 ~            MissionFlags    DB #00                                                          ; +5C, флаги наград, особого оборудования и занятого миссией трюма
 238++0000 ~            SunPosition     FSpacePosition                                                  ; +5D..65, координаты светила, копируются в FlightState.Sun
 239++0000                              ends
 240++0000
 241++0000
 242++0000                              ; проверка размера и критических границ сериализации
 243++0000                              ASSERT FCommander == #66
 244++0000                              ASSERT FCommander.LegalStatus == #0B
 245++0000                              ASSERT FCommander.Rating == #0C
 246++0000                              ASSERT FCommander.RankState == #0E
 247++0000                              ASSERT FCommander.JumpCount == #0F
 248++0000                              ASSERT FCommander.JumpFlags == #10
 249++0000                              ASSERT FCommander.CashHigh == #12
 250++0000                              ASSERT FCommander.Cargo == #17
 251++0000                              ASSERT FCommander.Cargo + FGoods == FCommander.FreeCargo
 252++0000                              ASSERT FCommander.GalaxySeed == #3C
 253++0000                              ASSERT FCommander.SystemSeed == #42
 254++0000                              ASSERT FCommander.MarketStock == #4A
 255++0000                              ASSERT FCommander.MarketStock + FGoods == FCommander.Mission3
 256++0000                              ASSERT FCommander.SunPosition == #5D
 257++0000
 258++0000                              endif

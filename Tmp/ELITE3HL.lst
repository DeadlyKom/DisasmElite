  22++0000              MAN_REV_BIT     EQU 0                                                           ; флаг, прокрутка к предыдущим строкам текста
  23++0000              MAN_REV_MASK    EQU 1 << MAN_REV_BIT                                            ; маска переключения направления просмотра
  24++0000              MAN_STEP_BIT    EQU 0                                                           ; флаг, две растровые строки за один шаг прокрутки
  25++0000              MAN_STEP_MASK   EQU 1 << MAN_STEP_BIT                                           ; маска включения двухстрочного шага
  26++0000              MAN_ROW_MASK    EQU #07                                                         ; числовой номер строки глифа, 0..7
  27++0000              MAN_WRAP_BIT    EQU 3                                                           ; разряд достижения восьмой строки, сбрасывается для перехода к нулю
  28++0000              MAN_KEYS_IGNORE EQU #FC                                                         ; единицы в игнорируемых разрядах общего опроса A/S и SPACE/SS
  29++0000
  30++0000              ; -----------------------------------------
  31++0000              ; первый байт токена упакованного руководства
  32++0000              ;      7    6    5    4    3    2    1    0
  33++0000              ;   +----+----+----+----+----+----+----+----+
  34++0000              ;   | PC | DP | DT | DT | DT | DT | DT | DT |
  35++0000              ;   +----+----+----+----+----+----+----+----+
  36++0000              ;
  37++0000              ;   PC      [7]     - признак упакованного токена, при нуле биты 6..0 содержат литерал
  38++0000              ;   DP      [6]     - при PC=1 выбирает словарную пару вместо обратной ссылки
  39++0000              ;   DT      [5..0]  - содержимое токена, формат зависит от PC и DP
  40++0000              ;   PC=1, DP=1      - биты 5..0 задают номер одной из 64 пар
  41++0000              ;   PC=1, DP=0      - биты 5..3 задают длину минус 3
  42++0000              ;                   - биты 2..0 задают старшие три разряда расстояния
  43++0000              ;                   - следующий байт содержит младшие восемь разрядов расстояния
  44++0000              ;   LN и DH ниже являются числовыми полями, а не игровыми флагами
  45++0000              ;
  46++0000              ;      7    6    5    4    3    2    1    0
  47++0000              ;   +----+----+----+----+----+----+----+----+
  48++0000              ;   | 1  | 0  | LN | LN | LN | DH | DH | DH |
  49++0000              ;   +----+----+----+----+----+----+----+----+
  50++0000              ; -----------------------------------------
  51++0000              PACK_CODE_BIT   EQU 7                                                           ; признак упакованного токена вместо буквального символа
  52++0000              PACK_PAIR_MIN   EQU #C0                                                         ; начало диапазона токенов словарных пар
  53++0000              PACK_DIST_MASK  EQU #07                                                         ; старшие три бита одиннадцатибитового расстояния
  54++0000              PACK_LEN_MASK   EQU #07                                                         ; трёхбитовое поле длины после трёх RRCA
  55++0000              PACK_LEN_BIAS   EQU #03                                                         ; минимальная длина копирования обратной ссылки
  56++0000              BEEP_SPK_MASK   EQU #10                                                         ; маска переключения выхода динамика в порту #FE
  57++0000
  58++0000                              endif                                                           ; ~_CONST_DISK_FLAGS_
  59++0000

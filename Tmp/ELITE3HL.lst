# file opened: Builder/Main.asm
   1  0000              ; -----------------------------------------
   2  0000              ; сборка семи файлов исходного диска ELITE3HL
   3  0000              ; адреса ORG здесь задают буфер ассемблера
   4  0000              ; исполняемые адреса встроенных программ задаются их исходниками
   5  0000              ; запуск из корня проекта, листинг и символы сохраняются в Tmp
   6  0000              ; требуется sjasmplus 1.20 или новее со встроенным Lua 5.4 или новее
   7  0000              ; задача Build напрямую запускает Tools/Sjasmplus/sjasmplus.exe
   8  0000              ; -----------------------------------------
   9  0000                              ; сброс прежнего результата до первого прохода сборки
  10  0000                              LUA PASS1
  11  0000 ~                                local path = "Tools/Disasm/Reports/BuildVerification.json"
  12  0000 ~                                local file = assert(io.open(path, "wb"))
  13  0000 ~                                assert(file:write('{\n  "checked_at_utc": "' ..
  14  0000 ~                                    os.date("!%Y-%m-%dT%H:%M:%SZ") ..
  15  0000 ~                                    '",\n  "status": "in_progress",\n  "method": "sjasmplus_lua",' ..
  16  0000 ~                                    '\n  "byte_identical": null\n}\n'))
  17  0000 ~                                assert(file:close())
  18  0000                              ENDLUA
  19  0000
  20  0000                              DEVICE ZXSPECTRUM48
  21  0000                              INCLUDE "../Includes/Structs/Include.inc"

  19++EBEA D5                           PUSH DE
  20++EBEB E5                           PUSH HL
  21++EBEC FD E5                        PUSH IY
  22++EBEE                              ; обновление снимка допускается только при остановке игрового потока на HALT
  23++EBEE CD 9F EC                     CALL IsGameHalted
  24++EBF1 20 13                        JR NZ, SelectFlagSlot                                           ; переход, если прерывание застало другую команду, использовать предыдущий снимок метаданных
  25++EBF3
  26++EBF3                              ; копирование восьми классификаторов с шагом 10 в плотный кеш
  27++EBF3 21 57 B4                     LD HL, ObjectEffects.Records
  28++EBF6 11 E1 EB                     LD DE, SlotFlagCache
  29++EBF9 06 08                        LD B, #08
  30++EBFB 7E           CacheSlotFlags: LD A, (HL)
  31++EBFC 12                           LD (DE), A
  32++EBFD 13                           INC DE
  33++EBFE C5                           PUSH BC
  34++EBFF 01 0A 00                     LD BC, FEffectRecord10
  35++EC02 09                           ADD HL, BC
  36++EC03 C1                           POP BC
  37++EC04 10 F5                        DJNZ CacheSlotFlags
  38++EC06

  17++EBAC FE 0C                        CP OBJ_STATION_FL
  18++EBAE C8                           RET Z                                                           ; выход, если Flags2=#0C, объект исключён из преследования
  19++EBAF
  20++EBAF 3D                           DEC A
  21++EBB0 FE 03                        CP #03
  22++EBB2 3F                           CCF
  23++EBB3 D0                           RET NC                                                          ; выход, если полный байт Flags2 равен 1..3, объект исключён из преследования
  24++EBB4

  23++BD65 DD 7E 00                     LD A, (IX+FVector3.X)
  24++BD68 CD 95 BD                     CALL Game.Motion.MultiplySignedWordByByte.Entry
  25++BD6B E5                           PUSH HL
  26++BD6C                              ; расчёт второго произведения компонент векторов
  27++BD6C FD 5E 03                     LD E, (IY+FAxis.Y+FSignWord.SignHigh)
  28++BD6F FD 4E 02                     LD C, (IY+FAxis.Y+FSignWord.Low)
  29++BD72 DD 7E 01                     LD A, (IX+FVector3.Y)
  30++BD75 CD 95 BD                     CALL Game.Motion.MultiplySignedWordByByte.Entry
  31++BD78 E5                           PUSH HL

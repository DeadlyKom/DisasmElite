; -----------------------------------------
; виртуальная матрица клавиатуры демонстрации, размер 8 байтов
; порядок полурядов совпадает с RLC B перед IN A, (C) в ReadKeyboard
; младшие пять бит, единица означает нажатую клавишу
; верхние три бита игнорируются игровым опросом
; память находится внутри экрана, структура не выделяет отдельный буфер
; -----------------------------------------
                struct FKeyboardRows
RowShiftZXCV    DB #00                                                          ; +00, CS, Z, X, C, V
RowASDFG        DB #00                                                          ; +01, A, S, D, F, G
RowQWERT        DB #00                                                          ; +02, Q, W, E, R, T
Row12345        DB #00                                                          ; +03, 1, 2, 3, 4, 5
Row09876        DB #00                                                          ; +04, 0, 9, 8, 7, 6
RowPOIUY        DB #00                                                          ; +05, P, O, I, U, Y
RowEnterLKJH    DB #00                                                          ; +06, EN, L, K, J, H
RowSpaceSMNB    DB #00                                                          ; +07, SP, SS, M, N, B
                ends
                ASSERT FKeyboardRows == 8

; -----------------------------------------
; RowShiftZXCV
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | V  | C  | X  | Z  | CS |
;   +----+----+----+----+----+----+----+----+
;
;   CS      [0]     - флаг, нажата клавиша CAPS SHIFT
;   Z       [1]     - флаг, нажата клавиша Z
;   X       [2]     - флаг, нажата клавиша X
;   C       [3]     - флаг, нажата клавиша C
;   V       [4]     - флаг, нажата клавиша V
;   ..      [7..5]  - не учитываются обработчиком клавиатуры
; -----------------------------------------

; -----------------------------------------
; RowASDFG
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | G  | F  | D  | S  | A  |
;   +----+----+----+----+----+----+----+----+
;
;   A       [0]     - флаг, нажата клавиша A
;   S       [1]     - флаг, нажата клавиша S
;   D       [2]     - флаг, нажата клавиша D
;   F       [3]     - флаг, нажата клавиша F
;   G       [4]     - флаг, нажата клавиша G
;   ..      [7..5]  - не учитываются обработчиком клавиатуры
; -----------------------------------------

; -----------------------------------------

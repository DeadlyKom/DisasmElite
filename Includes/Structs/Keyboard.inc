;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | 6  | 7  | 8  | 9  | 0  |
;   +----+----+----+----+----+----+----+----+
;
;   0       [0]     - флаг, нажата клавиша 0
;   9       [1]     - флаг, нажата клавиша 9
;   8       [2]     - флаг, нажата клавиша 8
;   7       [3]     - флаг, нажата клавиша 7
;   6       [4]     - флаг, нажата клавиша 6

                ifndef _STRUCTS_INPUTSTATE_
                define _STRUCTS_INPUTSTATE_

; исходный блок #FC08..#FC0F, обновляется обработчиком клавиатуры
; первые пять масок накапливаются через OR, отпускание клавиши не очищает биты
; NumberKeys и LastKey обновляются заново каждым опросом
; это маски игровых команд, полуряды аппаратной клавиатуры описаны FKeyboardRows
                struct FInputState                                              ; состояние игрового ввода [8 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | Y  | 0  | I  | O  | P  | K  | L  | EN |
;   +----+----+----+----+----+----+----+----+
;
;   Y / 0 / I / O / P / K / L / EN [7..0] - соответствующая клавиша нажата
;   EN      [0]     - ENTER
;   биты устанавливает таблица KeyboardMap, нажатия накапливаются до обработки потребителем
; -----------------------------------------
SystemKeys      DB #00                                                          ; маска клавиш Y, 0, I, O, P, K, L, ENTER
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | SS | SP | S  | X  | M  | N  |
;   +----+----+----+----+----+----+----+----+
;
;   SS      [5]     - SYMBOL SHIFT, уменьшение скорости
;   SP      [4]     - SPACE, увеличение скорости
;   S / X   [3..2]  - положительный / отрицательный тангаж
;   M / N   [1..0]  - положительный / отрицательный крен
;   биты 0..3 после нормализации содержат команды выбранного источника управления
;   биты 6..7 не назначены таблицей опроса
; -----------------------------------------
FlightKeys      DB #00                                                          ; нормализованные направления и изменение скорости
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | CS | J  | G  | H  | 4  | 3  | 2  | 1  |
;   +----+----+----+----+----+----+----+----+
;
;   CS      [7]     - CAPS SHIFT, запрос паузы
;   J / G / H [6..4] - клавиши J, G, H
;   4 / 3 / 2 / 1 [3..0] - выбор вида кабины
; -----------------------------------------
ViewJumpKeys    DB #00                                                          ; виды кабины, переходы и CAPS SHIFT
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | C  | Q  | W  | E  | U  | F  | T  | A  |
;   +----+----+----+----+----+----+----+----+
;
;   C       [7]     - запрос автоматической стыковки
;   W       [5]     - запрос энергетической бомбы
;   Q / E / U / F / T / A [6,4..0] - соответствующая клавиша нажата
;   в цифровом режиме клавиша 0 дополнительно устанавливает команду A
; -----------------------------------------
DeviceKeys      DB #00                                                          ; маска команд C, Q, W, E, U, F, T, A
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | R  | D  | B  | .. | .. | .. | .. |
;   +----+----+----+----+----+----+----+----+
;
;   R / D / B [6..4] - соответствующая клавиша нажата
;   остальные биты не назначены таблицей опроса
; -----------------------------------------
ChartKeys       DB #00                                                          ; маска клавиш R, D, B
LastKey         DB #FF                                                          ; последний символ, #FF нет клавиши, #FE сочетание 0 и CAPS SHIFT
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | SN | MJ | VY | RV | BR | ST | MD | MD |
;   +----+----+----+----+----+----+----+----+
;
;   SN      [7]     - флаг, разрешён звук
;   MJ      [6]     - флаг, принудительный выход гиперперехода в межзвёздное пространство
;   VY      [5]     - флаг, поменять местами направления тангажа
;   RV      [4]     - флаг, поменять местами направления обеих осей
;   BR      [3]     - флаг, тормозить отпущенную ось управления
;   ST      [2]     - флаг, обнулить угол при противоположной команде
;   MD      [1..0]  - номер источника направлений, это двухбитовое поле
;                     0 - буквенная клавиатура, 1..3 - варианты цифрового управления
; -----------------------------------------
Config          DB #8C                                                          ; режим источника, настройки направлений и звук
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | 7  | 6  | 8  | 5  | 9  |
;   +----+----+----+----+----+----+----+----+
;
;   7 / 6 / 8 / 5 / 9 [4..0] - соответствующая цифровая клавиша нажата
;   биты 5..7 не назначены таблицей опроса
; -----------------------------------------
NumberKeys      DB #00                                                          ; цифровые направления до нормализации
                ends
                ASSERT FInputState == 8

                endif                                                           ; ~_STRUCTS_INPUTSTATE_

                ifndef _STRUCT_COMMANDER_
                define _STRUCT_COMMANDER_

; -----------------------------------------
; сериализуемое состояние командира, #D054..#D0B9
; дисковый оверлей #CC41 копирует ровно #66 байт из #606F в #D054
; #CC65 сохраняет копию этих же #66 байт по #D232
; запись по #CCD4 передаёт сектор непосредственно от #D054
; логическая длина файла равна #66, остальные байты сектора принадлежат хвосту
; денежная сумма в кредитах равна (CashHigh * 10000 + CashLow) / 10
; числовые поля расположены младшим байтом вперёд
; -----------------------------------------
                struct FCommander                                               ; состояние пилота, ровно 102 байта
Name            TEXT 11, {#00}                                                  ; +00..0A, имя с нулём, ввод изменяет первые восемь байтов
LegalStatus     DB #00                                                          ; +0B, 0 законопослушный, 1..49 нарушитель, от 50 разыскивается
Rating          DW #0000                                                        ; +0C..0D, младшие 16 бит боевого рейтинга
; -----------------------------------------
; RankState, #D062, старший байт рейтинга и код военного состояния
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | WA | RS | RC | RC | RN | RN | RN | NX |
;   +----+----+----+----+----+----+----+----+
;
;   вне войны весь байт является старшим разрядом числового рейтинга
;   военный формат применяется при ненулевом State.Invasion
;   WA      [7]     - флаг, разрешён вывод воинского звания
;   RS      [6]     - флаг, отставка IN RESERVE, запрещает поиск секретной базы
;   RN      [3..1]  - номер воинского звания, извлекается маской RANK_NUM_MASK
;   NX      [0]     - флаг, разрешена проверка следующего предложения задания
;   RC      [5..4]  - разряды числового рейтинга, в номер воинского звания не входят
;   INC/DEC изменяют весь байт, NX и номер звания не являются независимыми счётчиками
;   начало вторжения устанавливает RANK_START_CODE, ответ Y увеличивает код на 1
;   RANK_RSV_BIT проверяется маской #40, это бит 6 при нумерации от нуля
; -----------------------------------------
RankState       DB #00                                                          ; +0E, старший разряд рейтинга и военное состояние, схема выше
JumpCount       DB #00                                                          ; +0F, младший байт счётчика, 16-битные обращения начинаются здесь
; -----------------------------------------
; JumpFlags, #D064, старшая часть счётчика переходов и разрешение миссии
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | MS | CT | CT | CT | CT | CT | CT | CT |
;   +----+----+----+----+----+----+----+----+
;
;   MS      [7]     - флаг, при следующем прибытии проверить выдачу старых миссий
;   CT      [6..0]  - старшие разряды числового счётчика переходов
;   CheckGrant проверяет и сбрасывает MS до передачи в GrantMission
;   UpdateInvasionOnRatingOverflow устанавливает MS при отказе запуска вторжения
;   счётчик увеличивается через INC младшего байта и перенос в весь JumpFlags
;   проверка допуска войны использует AND всего JumpFlags с RankState
; -----------------------------------------
JumpFlags       DB #00                                                          ; +10, старшая часть счётчика и разрешение выдачи миссии
Galaxy          DB #00                                                          ; +11, индекс галактики 0..7
CashHigh        DW #0000                                                        ; +12..13, целые тысячи кредитов
CashLow         DW #0000                                                        ; +14..15, остаток в десятых кредита, штатно меньше 10000
MarketRandom    DB #00                                                          ; +16, случайный параметр воспроизводимого рынка
Cargo           FGoods                                                          ; +17..27, количества товаров в трюме, структура FGoods
FreeCargo       DB #00                                                          ; +28, оставшееся место в трюме в тоннах
FrontLaser      DB #00                                                          ; +29, тип переднего лазера
RearLaser       DB #00                                                          ; +2A, тип заднего лазера
LeftLaser       DB #00                                                          ; +2B, тип левого лазера
RightLaser      DB #00                                                          ; +2C, тип правого лазера
Mission1        DB #00                                                          ; +2D, активность первой миссии, изменяется #DE6F
Fuel            DB #00                                                          ; +2E, топливо в десятых светового года, максимум 70
Missiles        DB #00                                                          ; +2F, число ракет, покупка ограничена четырьмя
LargeCargo      DB #00                                                          ; +30, расширенный трюм, используется #EA4C и #F0D8
; -----------------------------------------
; ECM, #D085, код устройства и текущая активность
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | ON | LV | LV | LV | LV | LV | LV | LV |
;   +----+----+----+----+----+----+----+----+
;
;   ON      [7]     - флаг, ECM включена до окончания CombatState.EcmTimer
;   LV      [6..0]  - числовая часть кода оборудования, не отдельные флаги
;   ActivateEnemyECM сохраняет исходный код C с установленным ON
;   ProcessLaserAndEcm сбрасывает ON при нулевом таймере, посадка также снимает его
;   общий DamageItem устанавливает старший бит перед INC кода устройства
;   поэтому наличие устройства проверяется по всему байту, а не только ON
; -----------------------------------------
ECM             DB #00                                                          ; +31, установленная ECM, бит 7 также участвует в повреждении
; -----------------------------------------
; AlienComputer, #D086, смещение FCommander.AlienComputer
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | CT | CT | CT | CT | CT | CT | CT | AC |
;   +----+----+----+----+----+----+----+----+
;
;   AC      [0]     - флаг, установлен ALIEN COMPUTER
;   #F051 проверяет его перед выводом названия, #5EEC перед заменой ракеты грузом
;   CT      [7..1]  - числовое поле, счётчик поражений проверяемой модели, не отдельные флаги
;   #8AA3 сравнивает младший адрес модели с #25 и дважды увеличивает весь байт
;   прибавление 2 сохраняет AC, только результат всего байта 0 создаёт контейнер
;   #D183 при подборе специального контейнера увеличивает весь байт на 1
;   #5E78 проверяет ненулевое значение всего AlienComputer вместе с MineralLife
;   самостоятельные назначения каждого из битов CT как флагов не установлены
; -----------------------------------------
AlienComputer   DB #00                                                          ; +32, ALIEN COMPUTER, бит 0 означает наличие, остальные биты содержат счётчик событий
; -----------------------------------------
; MineralLife, #D087, смещение FCommander.MineralLife
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | BL | SZ | SZ | SZ | SZ | SZ | SZ | SZ |
;   +----+----+----+----+----+----+----+----+
;
;   BL      [7]     - флаг, проверка жизнеспособности немедленно отклоняет колонию
;   #D5B4 выносит этот бит в перенос через RLC A и возвращается при C=1
;   SZ      [6..0]  - младшие разряды состояния колонии, не независимые флаги
;   #7370 при успешной колонизации записывает прежнее количество минералов
;   значение всего байта 0 означает отсутствие колонии и допускает её создание
;   #D5B4 считает положительное состояние живым только при Cargo[12]>=3
;   при нехватке минералов записывает весь байт #FF, запрещая повторное создание
;   #6EBC при отрицательной разности Cargo[15]-Cargo[12] сохраняет её по модулю 256
;   эту запись нельзя считать поразрядным изменением SZ либо BL
;   #6FFB и #E8AE сбрасывают весь MineralLife в 0
; -----------------------------------------
MineralLife     DB #00                                                          ; +33, MINERAL LIFE, 0 до колонизации, бит 7 запрещает живую колонию
FuelScoops      DB #00                                                          ; +34, топливный ковш, #DB6C разрешает пополнение топлива
EscapePod       DB #00                                                          ; +35, спасательная капсула
EnergyBomb      DB #00                                                          ; +36, энергетическая бомба
EnergyUnit      DB #00                                                          ; +37, энергетический блок
DockComputer    DB #00                                                          ; +38, стыковочный компьютер
GalacticDrive   DB #00                                                          ; +39, галактический гиперпривод, проверяется #DBC0
ShipUpgrade     DB #00                                                          ; +3A, Cobra Mk4, #FD после покупки, влияет на уровни оборудования
; -----------------------------------------
; Invasion, #D08F, фаза и величина области вторжения
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | AT | SZ | SZ | SZ | SZ | SZ | SZ | SZ |
;   +----+----+----+----+----+----+----+----+
;
;   AT      [7]     - флаг, код наступления таргонов
;   SZ      [6..0]  - величина фронта, числовое поле, не отдельные флаги
;   0 означает отсутствие вторжения, 1 завершённое состояние, от 2 область активна
;   #81..#FF кодируют наступление, #7F..#02 используются после снятия AT
;   таймер прибавляет NOT Invasion, геометрия использует удвоение всего байта
;   десант сбрасывает AT и уменьшает величину до освобождения текущей системы
; -----------------------------------------
Invasion        DB #00                                                          ; +3B, фаза и размер вторжения, #81..FF наступление, #7F..01 отступление
GalaxySeed      FSystemSeed                                                     ; +3C..41, три слова исходного семени галактики
SystemSeed      FSystemSeed                                                     ; +42..47, семя текущей системы, поля FSystemSeed
Technology      DB #00                                                          ; +48, технологический уровень текущей системы, счёт с нуля
Government      DB #00                                                          ; +49, правительство текущей системы, 0..7
MarketStock     FGoods                                                          ; +4A..5A, остатки товаров станции, последний слот обычно нулевой
; -----------------------------------------
; Mission3, #D0AF, числовой этап третьей миссии с отметкой попадания
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | HI | ST | ST | ST |
;   +----+----+----+----+----+----+----+----+
;
;   HI      [3]     - флаг, обработчик попадания отметил специальную цель
;   ST      [2..0]  - числовой этап миссии, штатные значения 0..6
;   бит 2 кода ST проверяется после установки HI, это проверка части этапа
;   при ST.2=0 обработчик сбрасывает весь Mission3 и назначает LegalStatus=#FF
;   при ST.2=1 отметка HI сохраняется, затем проверяется MissionFlags.MS_ACCEPT_BIT
; -----------------------------------------
Mission3        DB #00                                                          ; +5B, состояние третьей миссии, переходы проверены в #D123/#DDF7
; -----------------------------------------
; MissionFlags, #D0B0, смещение FCommander.MissionFlags
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | M3 | CL | CG | R5 | R4 | R3 | R2 | R1 |
;   +----+----+----+----+----+----+----+----+
;
;   M3      [7]     - флаг, принято предложение третьей миссии
;   #D138 устанавливает его при ответе Y, завершение #D14D не снимает
;   при Mission3=4 запрещает ECM игрока в #B7F4 и ответный ECM объекта в #A3A2
;   #F012..#F039 использует этот же бит для специальной подписи первого устройства
;   CL      [6]     - флаг, получено устройство маскировки
;   #D190 ставит при подборе предмета с кодом #FF, #7222 разрешает клавишу Y
;   #F05A выводит предмет, #7AE7 допускает особый энергетический признак объекта
;   #BBBA требует CL=0 вместе с R2=1 для начала особой встречи второй миссии
;   CG      [5]     - флаг, трюм занят беженцами либо десантом
;   #E6D6 ставит его после Y и очищает Cargo вместе с FreeCargo
;   #E6AE и #D730 запрещают повторное предложение, #F0B8 выводит особый груз
;   #E8AE снимает при высадке, #9C1C при спасении, #5EC5 при выпуске десанта
;   R5      [4]     - флаг, пятая отметка в общей проверке военного этапа #D729
;   отдельной команды установки этого бита в разобранном игровом коде не найдено
;   смысл конкретного выполненного задания по одному чтению не определяется
;   R4      [3]     - флаг, награда за третью миссию выдана
;   #D14D устанавливает его, #D729 читает как четвёртую отметку военного этапа
;   R3      [2]     - флаг, третья миссия уже выдана через #DE6F
;   #DE8B устанавливает его одновременно с Mission3=1
;   #D729 использует этот же бит как третью отметку военного этапа
;   R2      [1]     - флаг, вторая отметка общей последовательности заданий
;   #DE84 устанавливает её при выдаче следующего события
;   #D5F5 также ставит её после продажи продовольствия или оружия в разрешённой области
;   #BBBA читает комбинацию R2=1 и CL=0, #D729 проверяет вторую отметку этапа
;   R1      [0]     - флаг, первая отметка общей последовательности заданий
;   #DE6F устанавливает её одновременно с Mission1=1
;   #7FA1 также ставит её при разрешённой высадке беженцев во время вторжения
;   #D729 проверяет первую отметку этапа
;   #DE6F проверяет не один MissionFlags, а входное A AND MissionFlags
;   #D729 выбирает бит вращениями по номеру этапа, общая схема допускает биты 0..6
;   #5E78 при начале вторжения применяет AND #D0, очищая биты 5 и 3..0
;   поэтому R1..R3 нельзя однозначно назвать только завершёнными обычными миссиями
; -----------------------------------------
MissionFlags    DB #00                                                          ; +5C, флаги наград, особого оборудования и занятого миссией трюма
SunPosition     FSpacePosition                                                  ; +5D..65, координаты светила, копируются в FlightState.Sun
                ends


                ; проверка размера и критических границ сериализации
                ASSERT FCommander == #66
                ASSERT FCommander.LegalStatus == #0B
                ASSERT FCommander.Rating == #0C
                ASSERT FCommander.RankState == #0E
                ASSERT FCommander.JumpCount == #0F
                ASSERT FCommander.JumpFlags == #10
                ASSERT FCommander.CashHigh == #12
                ASSERT FCommander.Cargo == #17
                ASSERT FCommander.Cargo + FGoods == FCommander.FreeCargo
                ASSERT FCommander.GalaxySeed == #3C
                ASSERT FCommander.SystemSeed == #42
                ASSERT FCommander.MarketStock == #4A
                ASSERT FCommander.MarketStock + FGoods == FCommander.Mission3
                ASSERT FCommander.SunPosition == #5D

                endif

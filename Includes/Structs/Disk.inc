; -----------------------------------------
; запись каталога TR-DOS, размер 16 байтов
; каталог читается в DiskBuffer.Catalog, IX указывает начало одной записи
; младший байт многобайтовых чисел расположен первым
; -----------------------------------------
                struct FTrDosEntry
Name            DS 8, #00                                                       ; +00..07, восемь символов имени
Extension       DB #00                                                          ; +08, тип файла, для командира C
LoadAddress     DW #0000                                                        ; +09..0A, параметр файла, у сохранения 0
LengthLow       DB #00                                                          ; +0B, младший байт логической длины
LengthHigh      DB #00                                                          ; +0C, старший байт логической длины
SectorCount     DB #00                                                          ; +0D, выделенное число секторов
FirstSector     DB #00                                                          ; +0E, первый сектор, нумерация 0..15
; -----------------------------------------
; логическая дорожка TR-DOS
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | CY | CY | CY | CY | CY | CY | CY | SD |
;   +----+----+----+----+----+----+----+----+
;
;   CY      [7..1]  - числовой номер физического цилиндра
;   SD      [0]     - выбор стороны, SetTrackSide переносит его в Carry через RRA
;   значение 0 выбирает запись #3C в порт #FF, значение 1 выбирает #2C
; -----------------------------------------
FirstTrack      DB #00                                                          ; +0F, логическая дорожка, младший бит выбирает сторону
                ends
                ASSERT FTrDosEntry == #10

; -----------------------------------------
; служебный сектор TR-DOS, дорожка 0, сектор 9, размер 256 байтов
; Reserved и Tail сохраняются при чтении и записи, выделение их не интерпретирует
; -----------------------------------------
                struct FTrDosService
Reserved        DS #E1, #00                                                     ; +00..E0, сохранённая часть сектора
FreeSector      DB #00                                                          ; +E1, следующий свободный сектор, 0..15
; -----------------------------------------
; логическая дорожка TR-DOS
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | CY | CY | CY | CY | CY | CY | CY | SD |
;   +----+----+----+----+----+----+----+----+
;
;   CY      [7..1]  - числовой номер физического цилиндра
;   SD      [0]     - выбор стороны, SetTrackSide переносит его в Carry через RRA
;   значение 0 выбирает запись #3C в порт #FF, значение 1 выбирает #2C
; -----------------------------------------
FreeTrack       DB #00                                                          ; +E2, следующая свободная логическая дорожка
DiskType        DB #00                                                          ; +E3, байт типа диска, здесь не изменяется
FileCount       DB #00                                                          ; +E4, число занятых записей каталога
FreeCount       DW #0000                                                        ; +E5..E6, число свободных секторов
Tail            DS #19, #00                                                     ; +E7..FF, сохранённый хвост служебного сектора
                ends
                ASSERT FTrDosService == #100

; -----------------------------------------
; расшифрованная служебная отметка, дорожка #0D, сектор 1
; тот же DiskBuffer.Work временно содержит этот сектор вместо данных командира
; имена отражают проверки и формат вывода этой версии
; -----------------------------------------
                struct FDiskMark
Value           DW #0000                                                        ; +00..01, подтверждаемый 15-битный счётчик, старший бит очищается
NextValue       DW #0000                                                        ; +02..03, контрольное слово Value + 1
TimingKey       DW #0000                                                        ; +04..05, ключ преобразования и результат измерения
Counters        DS 6, #00                                                       ; +06..0B, три слова служебного меню
Suffix          DW #0000                                                        ; +0C..0D, необязательный числовой суффикс
Payload         DS #E4, #00                                                     ; +0E..F1, часть копии ПЗУ и защитных данных
OpenKey         DB #00                                                          ; +F2, открытый байт ключа после преобразования
Tail            DS #0D, #00                                                     ; +F3..FF, конец защитного сектора
                ends
                ASSERT FDiskMark == #100

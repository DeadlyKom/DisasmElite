                ifndef _STRUCT_GAME_WORKSPACE_
                define _STRUCT_GAME_WORKSPACE_

; -----------------------------------------
; шесть байтов семени участвуют в сложении трёх слов генератором AdvanceSystemSeed
; имена полей отражают чтение параметров системы до очередного шага генератора
; Word0 читается начиная с NameBits, Word1 с GovBits, Word2 с MixLow
; -----------------------------------------
                struct FSystemSeed                                              ; шестибайтовое семя одной системы
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | SD | LN | SD | SD | SD | SD | SD | SD |
;   +----+----+----+----+----+----+----+----+
;
;   LN      [6]     - флаг, имя содержит четыре слога вместо трёх, SEED_LONG_BIT
;   SD      [7,5..0] - остальные разряды числового семени, отдельных флагов нет
;   шаг генератора складывает всё слово NameBits/Y, включая разряд LN
; -----------------------------------------
NameBits        DB #00                                                          ; бит 6 выбирает четыре слога вместо трёх
Y               DB #00                                                          ; координата Y, биты 2..0 дают исходную экономику
GovBits         DB #00                                                          ; биты 5..3 задают правительство
X               DB #00                                                          ; координата X, биты 1..0 участвуют в технологии
MixLow          DB #00                                                          ; младший байт третьего слова при шаге генератора
Syllable        DB #00                                                          ; биты 4..0 задают индекс слога имени
                ends
                ASSERT FSystemSeed == 6

; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | PN | XX | XX | XX | XX | XX | XX | XX |
;   +----+----+----+----+----+----+----+----+
;
;   FFlightEvent.ColumnFlags:
;   PN      [7]     - флаг, событие ожидает показа
;   XX      [6..0]  - столбец печати сообщения, это единое числовое поле
;   Token содержит номер сообщения, после показа PN сбрасывается
;   восьмая и девятая пары также используются числовым форматированием
; -----------------------------------------
                struct FFlightEvent                                             ; запись очереди сообщений [2 байта]
ColumnFlags     DB #00                                                          ; признак ожидания и столбец сообщения
Token           DB #00                                                          ; токен сообщения основной таблицы
                ends
                ASSERT FFlightEvent == 2

                struct FGalaxyState                                             ; структура рабочего состояния [73 байт]
TargetSeed      FSystemSeed                                                     ; шестибайтовое семя выбранной цели
WorkingSeed     FSystemSeed                                                     ; рабочее семя перебора и генерации имени
SavedSeed       FSystemSeed                                                     ; копия рабочего семени на время вложенного перебора
TextSeed        DS 4, #00                                                       ; четыре байта генератора описаний
InputBuffer     DS 11, #00                                                      ; десять вводимых символов и завершающий ноль
GeneratedName   DS 9, #00                                                       ; восемь букв имени и завершающий ноль
CurrentName     DS 9, #00                                                       ; сохранённое имя текущей системы
TargetName      DS 9, #00                                                       ; сохранённое имя выбранной цели
Distance        DW #0000                                                        ; расстояние до цели в десятых светового года
Economy         DB #00                                                          ; экономика выбранной системы, индекс 0..7
Government      DB #00                                                          ; правительство выбранной системы, индекс 0..7
Technology      DB #00                                                          ; технологический уровень, счёт с нуля
Population      DB #00                                                          ; население в десятых миллиарда
Productivity    DW #0000                                                        ; производительность системы
Reserved        DS 2, #00                                                       ; сохранённые байты образа, обращений к полю не найдено
ScanIndex       DB #00                                                          ; индекс перебора, переполнение завершает 256 систем
NameCursor      DW #0000                                                        ; адрес следующего символа в GeneratedName
                ends
                ASSERT FGalaxyState == 73                                       ; проверка размера без выделения памяти

; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | RP | MD | MD | MD | MD | MD | MD | MD |
;   +----+----+----+----+----+----+----+----+
;
;   FSoundState.Mode:
;   RP      [7]     - флаг, после пакетов шума перейти к следующей фазе эффекта
;   MD      [6..0]  - код режима, 0 тишина, 1 скользящий тон, 2 тон из данных, 3 шум
;   RP проверяет StepNoise, остальные режимы не являются независимыми флагами
;   Duration сохраняет регистры DE между кадрами
;   в шуме E задаёт число пакетов, D задержку, в скользящем тоне роли D/E обратные
; -----------------------------------------
                struct FSoundState                                              ; структура рабочего состояния [5 байт]
Mode            DB #00                                                          ; 0 тишина, 1 скользящий тон, 2 тон из данных, остальные значения шум
Duration        DW #0000                                                        ; сохранённые DE, назначение D/E зависит от звукового режима
DataCursor      DW #0000                                                        ; сохранённый HL, адрес следующего отсчёта либо параметр тона
                ends
                ASSERT FSoundState == 5                                         ; проверка размера без выделения памяти

                struct FFaceState                                               ; структура рабочего состояния [12 байт]
Object          DW #0000                                                        ; сохранённый адрес исходного объекта из IX
Scale           DB #00                                                          ; сдвиг нормали из FModel.NormalScale
PositionX       DW #0000                                                        ; знако-модульная координата X для скалярного произведения
PositionY       DW #0000                                                        ; знако-модульная координата Y для скалярного произведения
PositionZ       DW #0000                                                        ; знако-модульная координата Z для скалярного произведения
NormalX         DB #00                                                          ; преобразованная знаковая компонента нормали X
NormalY         DB #00                                                          ; преобразованная знаковая компонента нормали Y
NormalZ         DB #00                                                          ; преобразованная знаковая компонента нормали Z
                ends
                ASSERT FFaceState == 12                                         ; проверка размера без выделения памяти

                struct FInputMotion                                             ; структура рабочего состояния [6 байт]
Roll            DW #0000                                                        ; крен, знако-модульное слово с дробной частью в младшем байте
Pitch           DW #0000                                                        ; тангаж, знако-модульное слово с дробной частью в младшем байте
Speed           DW #0000                                                        ; неотрицательная скорость, дробная часть в младшем байте
                ends
                ASSERT FInputMotion == 6                                        ; проверка размера без выделения памяти

                struct FMarketWork                                              ; структура рабочего состояния [9 байт]
Commodity       DB #00                                                          ; номер текущего товара, 0..16
CargoCursor     DW #0000                                                        ; адрес количества выбранного товара в трюме
PriceCursor     DW #0000                                                        ; адрес двухбайтовой цены выбранного товара
StockCursor     DW #0000                                                        ; адрес остатка выбранного товара на станции
TextPosition    DW #0000                                                        ; сохранённые столбец и строка печати
                ends
                ASSERT FMarketWork == 9                                         ; проверка размера без выделения памяти

                struct FTradeSnapshot                                           ; структура рабочего состояния [10 байт]
CashHigh        DW #0000                                                        ; сохранённое старшее слово денег перед сделкой
CashLow         DW #0000                                                        ; сохранённое младшее слово денег перед сделкой
CargoCount      DB #00                                                          ; сохранённое количество товара в трюме
StockCount      DB #00                                                          ; сохранённый остаток товара станции
FreeCargo       DB #00                                                          ; сохранённый свободный объём трюма
Selection       DB #00                                                          ; введённое количество товара либо номер покупаемого оборудования
Validator       DW #0000                                                        ; адрес проверки очередного изменения количества
                ends
                ASSERT FTradeSnapshot == 10                                     ; проверка размера без выделения памяти

                struct FEquipmentWork                                           ; структура рабочего состояния [5 байт]
ItemLimit       DB #00                                                          ; наибольший номер разрешённого оборудования
ItemIndex       DB #00                                                          ; номер пункта при выводе списка оборудования
PriceCursor     DW #0000                                                        ; адрес текущей трёхбайтовой цены оборудования
LaserType       DB #00                                                          ; код выбранного типа лазера
                ends
                ASSERT FEquipmentWork == 5                                      ; проверка размера без выделения памяти

                struct FTextInput                                               ; структура рабочего состояния [4 байт]
Length          DB #00                                                          ; число введённых символов
Cursor          DW #0000                                                        ; адрес следующего символа в буфере ввода
LastKey         DB #00                                                          ; последний принятый код клавиши
                ends
                ASSERT FTextInput == 4                                          ; проверка размера без выделения памяти

                struct FMapViewport                                             ; структура рабочего состояния [3 байт]
CrosshairSize   DB #00                                                          ; полуширина перекрестия карты в пикселях
Top             DB #00                                                          ; верхняя строка области карты
Bottom          DB #00                                                          ; нижняя строка области карты
                ends
                ASSERT FMapViewport == 3                                        ; проверка размера без выделения памяти

                struct FFlightMessage                                           ; структура рабочего состояния [8 байт]
RepeatTimer     DB #00                                                          ; таймер повторного предупреждения
Frames          DB #00                                                          ; оставшееся время показа сообщения
QueuePhase      DB #00                                                          ; фаза чередования очереди и фоновых сообщений
Column          DB #00                                                          ; столбец текущего сообщения
Token           DB #00                                                          ; токен текущего сообщения
Reward          DW #0000                                                        ; денежная награда для сообщения о премии
DamagedItem     DB #00                                                          ; код повреждённого оборудования
                ends
                ASSERT FFlightMessage == 8                                      ; проверка размера без выделения памяти

                endif                                                           ; ~_STRUCT_GAME_WORKSPACE_

                ifndef _STRUCTS_MARKET_
                define _STRUCTS_MARKET_

                struct FMarketEntry                                             ; исходные параметры одного товара [4 байта]
Price           DB #00                                                          ; базовая цена, GenerateMarket масштабирует результат в четыре раза
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | NG | .. | .. | EC | EC | EC | EC | EC |
;   +----+----+----+----+----+----+----+----+
;
;   NG      [7]     - флаг, отрицательный коэффициент экономики
;   EC      [4..0]  - модуль коэффициента экономики
;   биты 5..6 генератор рынка не использует
; -----------------------------------------
Economy         DB #00                                                          ; знак и модуль коэффициента экономики
Stock           DB #00                                                          ; базовый запас до случайной и экономической поправок
RandomMask      DB #00                                                          ; маска случайного параметра системы
                ends
                ASSERT FMarketEntry == 4

                struct FEquipmentPrice                                          ; стоимость оборудования [3 байта]
High            DB #00                                                          ; целые тысячи кредитов
Low             DW #0000                                                        ; младшая денежная группа, 0..9999 десятых кредита
                ends
                ASSERT FEquipmentPrice == 3

                endif                                                           ; ~_STRUCTS_MARKET_

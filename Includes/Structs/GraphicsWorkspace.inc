                ifndef _STRUCTS_GRAPHICS_WORKSPACE_
                define _STRUCTS_GRAPHICS_WORKSPACE_

                struct FCircleState                                             ; структура рабочей области, поля следуют исходному расположению
OffsetY         DB #00                                                          ; модуль вертикального смещения центра
OffsetX         DB #00                                                          ; модуль горизонтального смещения центра
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | VY | VX | SY | SX |
;   +----+----+----+----+----+----+----+----+
;
;   SX      [0]     - флаг, центр X правее середины области, CIRC_RIGHT_BIT
;   SY      [1]     - флаг, центр Y выше середины области, CIRC_UP_BIT
;   VX      [2]     - флаг, обычная ветвь горизонтального отсечения, CIRC_XRANGE_BIT
;                     1 - сравнить модуль X с полушириной
;                     0 - при X >= полуширины выйти, иначе отсечь внешний центр
;   VY      [3]     - флаг, обычная ветвь вертикального отсечения, CIRC_YRANGE_BIT
;                     1 - сравнить модуль Y с полувысотой
;                     0 - при Y >= полувысоты выйти, иначе отсечь внешний центр
; -----------------------------------------
Flags           DB #00                                                          ; знаки и признаки диапазона центра, схема в FCircleState
Radius          DB #00                                                          ; радиус окружности в пикселях
ClipY           DB #00                                                          ; рабочий модуль Y или расстояние до вертикальной границы
ClipX           DB #00                                                          ; рабочий модуль X или расстояние до боковой границы
ScreenY         DB #00                                                          ; экранная строка центра или начало отсечённой дуги
ScreenX         DB #00                                                          ; экранный столбец центра
Cathetus        DB #00                                                          ; катет точки пересечения круга с границей
SavedSP         DW #0000                                                        ; реальный стек до временного заполнения или чтения таблицы
Radicand        DW #0000                                                        ; подкоренное значение r*r - d*d - входной перенос
LeftMask        DB #00                                                          ; маска левого края перед заполнением строки
DirectionDown   DB #00                                                          ; направление дуги, 0 вверх, 1 вниз
OutlineOnly     DB #00                                                          ; режим окружности, 0 заливка, 1 только контур
PatchCount      DB #00                                                          ; число байтов патча области обзора
                ends

                struct FProjectionState                                         ; структура рабочей области, поля следуют исходному расположению
Depth           DW #0000                                                        ; глубина объекта, младший байт затем переиспользуется как уровень детализации
VertexOffset    DB #00                                                          ; смещение трёхбайтовой записи в таблице экранных вершин
X               DW #0000                                                        ; повёрнутая X-компонента, затем X с добавленным положением объекта
Y               DW #0000                                                        ; повёрнутая Y-компонента, затем Y с добавленным положением объекта
Z               DW #0000                                                        ; повёрнутая Z-компонента, затем Z с добавленным положением объекта
ScreenX         DB #00                                                          ; модуль горизонтальной проекции центра или вершины
ScreenY         DB #00                                                          ; модуль вертикальной проекции центра или вершины
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | SX | SY |
;   +----+----+----+----+----+----+----+----+
;
;   SX      [1]     - флаг, горизонтальная проекция вычитается из центра, PROJ_NEGX_BIT
;   SY      [0]     - флаг, вертикальная проекция прибавляется к центру, PROJ_POSY_BIT
;                     для вершины за камерой в таблицу записывается #FF
;                     верхние шесть бит проекции центра не используются
; -----------------------------------------
Flags           DB #00                                                          ; бит 1 знак X, бит 0 знак Y, схема в FProjectionState
SignX           DB #00                                                          ; знаковый старший байт пространственной координаты X
SignY           DB #00                                                          ; знаковый старший байт пространственной координаты Y
SignZ           DB #00                                                          ; знаковый старший байт пространственной координаты Z
Scale           DB #00                                                          ; число левых сдвигов для повышенной точности ближней вершины
NoCache         DB #00                                                          ; флаг, произведения предыдущей вершины нельзя использовать
                ends

                struct FProjectedVertex                                         ; экранная вершина, три байта в массиве ProjectedVerts
X               DB #00                                                          ; +00, модуль горизонтального смещения
Y               DB #00                                                          ; +01, модуль вертикального смещения
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | HI | .. | .. | .. | .. | .. | SX | SY |
;   +----+----+----+----+----+----+----+----+
;
;   HI      [7]     - флаг, вершина скрыта, VERT_HIDDEN_BIT
;   SX      [1]     - флаг, X вычитается из центра, PROJ_NEGX_BIT
;   SY      [0]     - флаг, Y прибавляется к центру, PROJ_POSY_BIT
;   видимая вершина получает два младших бита из ProjectionState.Flags
;   скрытая вершина получает весь байт VERT_HIDDEN=#FF
;   при HI=1 остальные биты не являются действительными знаками координат
; -----------------------------------------
Flags           DB #00                                                          ; +02, знаки экранного смещения либо маркер скрытия
                ends

                ; проверка размера исходной записи таблицы экранных вершин
                ASSERT FProjectedVertex == 3

                struct FCompassState                                            ; структура рабочей области, поля следуют исходному расположению
SunNear         DB #00                                                          ; флаг, солнце в ближнем диапазоне
PlanetNear      DB #00                                                          ; флаг, планета в ближнем диапазоне
X               DB #00                                                          ; нормированная координата X
Y               DB #00                                                          ; нормированная координата Y
Behind          DB #00                                                          ; флаг, цель за кораблём
                ends

                struct FRotationState                                           ; структура рабочей области, поля следуют исходному расположению
Roll            DB #00                                                          ; угол крена
Pitch           DB #00                                                          ; угол тангажа
                ends

                struct FSteeringVector                                          ; структура рабочей области, поля следуют исходному расположению
X               DW #0000                                                        ; знаковая X-компонента
Y               DW #0000                                                        ; знаковая Y-компонента
Z               DW #0000                                                        ; знаковая Z-компонента
Length          DW #0000                                                        ; длина вектора
                ends

                struct FSpacePosition                                           ; три координаты по три байта
X               FCoordinate
Y               FCoordinate
Z               FCoordinate
                ends

                struct FScannerState                                            ; рабочие координаты и состояние обхода сканера [5 байтов]
ScaledX         DB #00                                                          ; масштабированная X, знак в бите 7
ScaledY         DB #00                                                          ; масштабированная высота Y, знак в бите 7
ScaledZ         DB #00                                                          ; масштабированная глубина Z, знак в бите 7
ObjectIndex     DB #00                                                          ; обратный номер обрабатываемого слота, 8..1
Redraw          DB #00                                                          ; флаг, фон сканера изменён и требует восстановления
                ends

                struct FObjectEffects                                           ; управление расширенными эффектами перед массивом записей [5 байтов]
Current         DW #0000                                                        ; указатель текущей FEffectRecord10
Phase           DB #00                                                          ; фаза 1..3 в младших двух битах
Remaining       DB #00                                                          ; счётчик оставшихся слотов, 8..1
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | AG | .. | .. |
;   +----+----+----+----+----+----+----+----+
;
;   AG      [2]     - флаг, разрешены агрессивные взаимодействия
;                     устанавливается при LegalStatus >= #38 или конфликте связей
;                     остальные биты данного общего байта не используются
; -----------------------------------------

Flags           DB #00                                                          ; общие признаки взаимодействия
                ends

                endif                                                           ; ~_STRUCTS_GRAPHICS_WORKSPACE_

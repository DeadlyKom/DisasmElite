                ifndef _CONST_DISK_FLAGS_
                define _CONST_DISK_FLAGS_

; -----------------------------------------
; результаты поиска TR-DOS и числовые границы каталога
; это не набор независимых флагов контроллера диска
; -----------------------------------------
DOS_FAIL_BIT    EQU 7                                                           ; признак неудачного поиска файла в результате функции TR-DOS #0A
DOS_SIGN_BIT    EQU 7                                                           ; знак старшего байта числа свободных секторов после DEC HL
DOS_FULL_BIT    EQU 7                                                           ; разряд числа записей, установлен при достижении 128
DOS_SEC_MASK    EQU #0F                                                         ; четырёхбитовый номер сектора внутри дорожки, 0..15
DOS_WRAP_MASK   EQU #F0                                                         ; разряды переноса за пределы шестнадцати секторов
DOS_TRACK_SIZE  EQU #10                                                         ; число секторов логической дорожки
DOS_CAT_MASK    EQU #07                                                         ; номер сектора каталога до прибавления единицы, 0..7
DOS_SLOT_MASK   EQU #F0                                                         ; смещение шестнадцатибайтовой записи внутри сектора
MARK_TOP_BIT    EQU 7                                                           ; разряд H, сбрасываемый при ограничении отметки пятнадцатью битами

; -----------------------------------------
; два однобайтовых состояния просмотрщика, см. Source/Manual/Data.asm
; у Reverse и DoubleStep устанавливается только бит 0, остальные разряды равны нулю
; -----------------------------------------
MAN_REV_BIT     EQU 0                                                           ; флаг, прокрутка к предыдущим строкам текста
MAN_REV_MASK    EQU 1 << MAN_REV_BIT                                            ; маска переключения направления просмотра
MAN_STEP_BIT    EQU 0                                                           ; флаг, две растровые строки за один шаг прокрутки
MAN_STEP_MASK   EQU 1 << MAN_STEP_BIT                                           ; маска включения двухстрочного шага
MAN_ROW_MASK    EQU #07                                                         ; числовой номер строки глифа, 0..7
MAN_WRAP_BIT    EQU 3                                                           ; разряд достижения восьмой строки, сбрасывается для перехода к нулю
MAN_KEYS_IGNORE EQU #FC                                                         ; единицы в игнорируемых разрядах общего опроса A/S и SPACE/SS

; -----------------------------------------
; первый байт токена упакованного руководства
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | PC | DP | DT | DT | DT | DT | DT | DT |
;   +----+----+----+----+----+----+----+----+
;
;   PC      [7]     - признак упакованного токена, при нуле биты 6..0 содержат литерал
;   DP      [6]     - при PC=1 выбирает словарную пару вместо обратной ссылки
;   DT      [5..0]  - содержимое токена, формат зависит от PC и DP
;   PC=1, DP=1      - биты 5..0 задают номер одной из 64 пар
;   PC=1, DP=0      - биты 5..3 задают длину минус 3
;                   - биты 2..0 задают старшие три разряда расстояния
;                   - следующий байт содержит младшие восемь разрядов расстояния
;   LN и DH ниже являются числовыми полями, а не игровыми флагами
;
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | 1  | 0  | LN | LN | LN | DH | DH | DH |
;   +----+----+----+----+----+----+----+----+
; -----------------------------------------
PACK_CODE_BIT   EQU 7                                                           ; признак упакованного токена вместо буквального символа
PACK_PAIR_MIN   EQU #C0                                                         ; начало диапазона токенов словарных пар
PACK_DIST_MASK  EQU #07                                                         ; старшие три бита одиннадцатибитового расстояния
PACK_LEN_MASK   EQU #07                                                         ; трёхбитовое поле длины после трёх RRCA
PACK_LEN_BIAS   EQU #03                                                         ; минимальная длина копирования обратной ссылки
BEEP_SPK_MASK   EQU #10                                                         ; маска переключения выхода динамика в порту #FE

                endif                                                           ; ~_CONST_DISK_FLAGS_

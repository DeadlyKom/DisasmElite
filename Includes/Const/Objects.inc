                ifndef _CONST_OBJECTS_
                define _CONST_OBJECTS_

; -----------------------------------------
; FSpaceObject.Flags, состояние и трёхбитный остаток запусков
; -----------------------------------------
OBJ_ESCAPE_BIT  EQU 7                                                           ; флаг, корабль может выпустить спасательную капсулу
OBJ_ACTIVE_BIT  EQU 6                                                           ; флаг, объект проходит управление кораблём
OBJ_EXPLODE_BIT EQU 5                                                           ; флаг, объект переведён в состояние взрыва
OBJ_DESTROY_BIT EQU 4                                                           ; флаг, запрошена обработка уничтожения объекта
OBJ_LASER_BIT   EQU 3                                                           ; флаг, требуется вывести лазерный луч объекта
OBJ_LAUNCH4_BIT EQU 2                                                           ; старший разряд числового остатка запусков, вес 4
OBJ_LAUNCH_MASK EQU #07                                                         ; маска числового остатка запусков, 0..7

; -----------------------------------------
; FSpaceObject.Flags2, дополнительные признаки и отдельные значения одного бита
; -----------------------------------------
OBJ_HIT_BIT     EQU 7                                                           ; флаг, ракета поразила специальную цель миссии
OBJ_ALIEN_BIT   EQU 7                                                           ; флаг, контейнер содержит ALIEN COMPUTER, отдельное применение бита 7
OBJ_FAR_BIT     EQU 7                                                           ; флаг, станционный слот запрещает возврат в ближний режим
OBJ_MISSION_BIT EQU 6                                                           ; флаг, особый корабль второй миссии
OBJ_RETREAT_BIT EQU 5                                                           ; флаг, выбран курс удаления от игрока
OBJ_NOTSHIP_BIT EQU 3                                                           ; флаг, объект исключён из счётчика обычных кораблей
OBJ_SPECIAL_BIT EQU 2                                                           ; флаг, отдельные правила дальности, поражения и поведения
OBJ_SCOOP_BIT   EQU 1                                                           ; флаг, объект допускает подбор грузовым ковшом
OBJ_MISSILE_BIT EQU 0                                                           ; флаг, объект обрабатывается как управляемая ракета

; -----------------------------------------
; FSpaceObject.Hostility, признаки действующего корабля
; -----------------------------------------
OBJ_FLEE_BIT    EQU 3                                                           ; флаг, при существующей станции выбрать удаление вместо преследования
OBJ_HOSTILE_BIT EQU 2                                                           ; флаг, объект враждебен, разрешены преследование и стрельба
OBJ_ANGER_BIT   EQU 1                                                           ; флаг, выбор курса может включить враждебность по рейтингу игрока
OBJ_FAST_BIT    EQU 0                                                           ; флаг, предел скорости модели увеличивается в четыре раза

; -----------------------------------------
; FSpaceObject.Target, только формат обычного корабля
; -----------------------------------------
TARGET_ACCL_BIT EQU 7                                                           ; флаг, автопилот задаёт принудительное ускорение 2
TARGET_ECM_BIT  EQU 0                                                           ; флаг, корабль может включить ECM при обнаружении ракеты
TARGET_AI_MASK  EQU #7F                                                         ; числовой параметр поведения, включает младший бит ECM

; -----------------------------------------
; FEffectRecord10.TypeFlags, обычный формат расширенного взаимодействия
; -----------------------------------------
FX_ACTIVE_BIT   EQU 7                                                           ; флаг, запись допускается как цель взаимодействия
FX_GROUP_BIT    EQU 6                                                           ; флаг, совместимость определяется двухбитными группами
FX_TIMER_BIT    EQU 5                                                           ; флаг, запись участвует в обновлении таймера и особого эффекта
FX_SEARCH_BIT   EQU 4                                                           ; флаг, разрешён поиск новой резервной цели
FX_ENERGY_BIT   EQU 3                                                           ; флаг, применяется энергетический эффект вместо обычного каркаса
FX_ALLOW_BIT    EQU 2                                                           ; флаг, дополнительный допуск взаимодействия с отдельными целями
FX_GROUP_MASK   EQU #03                                                         ; маска числовой группы взаимодействия, 0..3
FX_GROUP_KEEP   EQU #FC                                                         ; все разряды вне двухбитной группы, для проверки группы 3
FX_PAIR_MASK    EQU (1 << FX_ACTIVE_BIT) | (1 << FX_GROUP_BIT)                  ; активная запись с групповым взаимодействием
FX_SEARCH_MASK  EQU FX_PAIR_MASK | (1 << FX_SEARCH_BIT)                         ; допуск столкновения, одновременно AC, GM и SR
FX_KIND_MASK    EQU #F0                                                         ; верхняя тетрада типа при поиске резервного участника
FX_RESERVE_KIND EQU (1 << FX_ACTIVE_BIT) | (1 << FX_SEARCH_BIT)                 ; тип резервной цели с верхней тетрадой 9

; -----------------------------------------
; FEffectRecord10.Fallback и Links, номера целей не являются флагами
; -----------------------------------------
FX_NOSTAT_BIT   EQU 7                                                           ; флаг, запрещён случайный выбор станции резервной целью
FX_NOSTAT_MASK  EQU 1 << FX_NOSTAT_BIT                                          ; маска сохранения запрета станции при смене номера цели
FX_LINK_MASK    EQU #0F                                                         ; маска числового номера текущей или резервной цели
FX_PREV_MASK    EQU #F0                                                         ; маска числового номера предыдущей цели

; -----------------------------------------
; FModel.Flags и LaunchMask, исходные свойства модели
; -----------------------------------------
MODEL_AI_MASK   EQU #6F                                                         ; разряды Flags, копируемые в FSpaceObject.Hostility
MODEL_SHOT_MASK EQU #F0                                                         ; старшая тетрада выбора действия при запуске содержимого
MODEL_LOOT_MASK EQU #0F                                                         ; младшая тетрада типа подбираемого содержимого

                module ObjectFlag
LaunchCount:    EQU OBJ_LAUNCH_MASK                                             ; маска числового остатка запусков
Laser:          EQU 1 << OBJ_LASER_BIT                                          ; флаг, требуется вывести лазерный луч
Destroy:        EQU 1 << OBJ_DESTROY_BIT                                        ; флаг, запрошено уничтожение
Exploding:      EQU 1 << OBJ_EXPLODE_BIT                                        ; флаг, объект изображается взрывом
ActiveShip:     EQU 1 << OBJ_ACTIVE_BIT                                         ; флаг, действует управление кораблём
EscapePod:      EQU 1 << OBJ_ESCAPE_BIT                                         ; флаг, доступна спасательная капсула
                endmodule

                module ObjectFlag2
Missile:        EQU 1 << OBJ_MISSILE_BIT                                        ; флаг, управляемая ракета
Scoopable:      EQU 1 << OBJ_SCOOP_BIT                                          ; флаг, допускается подбор ковшом
KeepDistance:   EQU 1 << OBJ_SPECIAL_BIT                                        ; флаг, особые правила дальности и поведения
NotShip:        EQU 1 << OBJ_NOTSHIP_BIT                                        ; флаг, объект не учитывается как обычный корабль
Retreat:        EQU 1 << OBJ_RETREAT_BIT                                        ; флаг, выбран курс удаления
MissionTwo:     EQU 1 << OBJ_MISSION_BIT                                        ; флаг, объект второй миссии
MissionHit:     EQU 1 << OBJ_HIT_BIT                                            ; флаг, поражена специальная цель
                endmodule

; -----------------------------------------
; составные состояния, сравниваются как полный байт либо указанная маска
; -----------------------------------------
OBJ_DEATH_MASK  EQU (1 << OBJ_DESTROY_BIT) | (1 << OBJ_EXPLODE_BIT)             ; маска запроса уничтожения и состояния взрыва
OBJ_LAW_MASK    EQU #60                                                         ; признаки опасности и изменения законности, любой из двух разрядов
OBJ_CLASS_MASK  EQU #0F                                                         ; маска младших признаков специального класса в Flags2
OBJ_STATION_FL  EQU ObjectFlag2.NotShip | ObjectFlag2.KeepDistance              ; полное значение Flags2 специальной станции
OBJ_CARGO_FL    EQU ObjectFlag2.NotShip | ObjectFlag2.Scoopable                 ; полное значение Flags2 обычного подбираемого груза
OBJ_LOST_FL     EQU ObjectFlag2.Missile | ObjectFlag2.Scoopable                 ; полное значение Flags2 ракеты после потери цели

; -----------------------------------------
; разряды числового таймера, адаптивного порога и упакованного потока рёбер
; -----------------------------------------
FX_SEARCH_TICK  EQU 0                                                           ; разряд таймера, поиск новой резервной цели разрешён при нечётном Timer
FX_LASER_TICK   EQU 1                                                           ; разряд таймера, единица блокирует лазер при непустых ссылках
FX_PHASE4_BIT   EQU 2                                                           ; старший разряд числовой фазы кругового эффекта, диапазон 4..7
LASER_PASS_BIT  EQU 7                                                           ; разряд истории, добавляется при допуске случайного сравнения или попадании
LASER_BASE_BIT  EQU 5                                                           ; разряд веса 32, поддерживает нижнюю границу адаптивного порога
EDGE_DIRECT_BIT EQU 5                                                           ; флаг, байт содержит порог ребра, иначе это счётчик повторов следующего порога
EDGE_LOD_MASK   EQU #1F                                                         ; маска пятибитного порога детализации ребра
EDGE_V1_BIT     EQU 6                                                           ; старший разряд индекса первой вершины упакованного ребра
EDGE_V2_BIT     EQU 7                                                           ; старший разряд индекса второй вершины упакованного ребра

                endif
